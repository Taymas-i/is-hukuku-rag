# Hepsi isteğe bağlı, varsayılanlar app/config.py içinde. Değiştirmek için .env'e kopyalayın.

# Yerel (varsayılan)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b

# Bulut: daha doğru cevaplar için
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_key_here

TOP_K=5
# eval/evaluate.py'nin önerdiği değerle güncelleyin
RELEVANCE_THRESHOLD=0.3
